# ohdo-web 환경변수 템플릿
# 로컬 dev 시: .env.local 로 복사해 사용 (Vercel 은 대시보드 Variables 탭에 등록)
#
# packages/web 은 백엔드와 통신할 때 Next.js rewrites 경유. 즉 브라우저는 항상
# 이 사이트의 origin (예: localhost:3000 또는 vercel URL) 에만 요청한다.
# rewrites 의 destination 만 아래 변수로 결정.

# 백엔드 URL — Next.js server 가 rewrites 로 proxy 할 대상.
# 로컬 backend 띄울 땐 비우거나 http://localhost:8000.
# 프로덕션 (Vercel) 에선 Railway URL 사용.
API_BASE_URL=http://localhost:8000
