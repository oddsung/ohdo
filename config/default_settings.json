{
  "ai": {
    "selected": "cli_ai",
    "available_engines": {
      "cli_ai": {
        "preset": "agy",
        "command": "agy",
        "model": "",
        "timeout_seconds": 120,
        "max_retries": 3
      },
      "openai_compat": {
        "preset": "openai",
        "base_url": "https://api.openai.com/v1",
        "api_key": "",
        "api_key_env": "OPENAI_API_KEY",
        "model": "gpt-4o-mini",
        "timeout_seconds": 180,
        "max_retries": 3,
        "max_tokens": 4096,
        "temperature": 0.3
      }
    }
  },
  "image": {
    "capture_quality": 60,
    "max_width": 1280,
    "format": "jpeg",
    "grayscale_for_ai": false
  },
  "recognition": {
    "preferred_methods": [
      "dom",
      "automation_id",
      "ocr",
      "image_match"
    ],
    "ocr_language": "kor+eng",
    "image_match_confidence": 0.8
  },
  "execution": {
    "step_delay_ms": 500,
    "max_retry_count": 3,
    "retry_delay_ms": 1000,
    "screenshot_on_error": true,
    "sandbox_mode": true,
    "auto_regenerate_on_warning": false,
    "auto_run_on_step_create": false
  },
  "visual_feedback": {
    "enabled": true
  },
  "ui": {
    "theme": "dark",
    "console_visible": true,
    "font_size": 11,
    "language": "auto",
    "hint_run_shown": false
  },
  "output_project": {
    "default_output_dir": "",
    "auto_readme": true,
    "auto_requirements": true,
    "auto_venv_guide": true,
    "include_run_script": true,
    "readme_language": "ko"
  },
  "logging": {
    "level": "INFO",
    "file_enabled": true,
    "max_log_size_mb": 50,
    "rotation_days": 30
  },
  "element_picker": {
    "uia_max_depth": 15,
    "uia_time_budget_ms": 150,
    "post_pause_transition_ms": 0,
    "cdp_enabled": false
  },
  "hints": {
    "cdp_browser_hint_dismissed": false
  }
