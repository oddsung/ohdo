venv/
.venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# 환경 설정 (컴퓨터별 고유 설정)
config/environment.json
config/settings.json

# 세션 데이터 (사용자별 데이터)
data/sessions/
data/

# 로그
*.log
logs/

# 테스트 실행 결과 (자동 생성, 노이즈)
tests/results/
pyside6_port/tests/results/

# 5/5 백업 폴더 — 5/2 PySide6 마이그레이션 안전 사본
ohdo_20260505_backup/

# 임시 디버깅 스크립트 (커밋 X)
test_click_diagnosis.py
uia_test.py
uia_desktop_test.py
encoding_test.py
sandbox_test.py
preview_*.png
preview_*.py
step?_*.py
step?_*.txt

# 임시 파일
*.tmp
*.temp
.cache/
tmp/

# 비공개 전략 문서 (handoff §83b — repo public 전환 시 트리 제외, 로컬 보관)
docs_private/

# Secrets / credentials (broad guard — 공개 직전 추가, 5/9)
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx
*credentials*
*secret*
# ADR 0003 (PR-1~10) — 시크릿 처리 소스 코드 모듈은 ignore 예외.
# 위 `*secret*` / `*credentials*` 는 .env, secrets.json, credentials.json 같은
# 설정/데이터 파일 차단 의도 — 소스 코드는 commit 되어야 함.
!core/secrets.py
!core/secrets_*.py
!core/windows_credentials.py
!ui/windows_credentials_*.py
!ui_v2/secret_*.py
# ADR/architecture 문서 (파일명에 'secrets' 포함) 도 commit 대상
!docs/**/*secrets*.md
# 디버깅·대화 로그 (ohdo 가 generate_step 마다 prompt+code 를 tmp/conversations/ 에 저장)
tmp/

# M2.8: Agent 가 동반 배포할 Python 임베디드 (빌드 시 scripts/fetch-embedded-python.ps1 로 재생성)
agent/vendor/

# M3.1.2: Next.js web dashboard (`packages/web/`)
packages/web/node_modules/
packages/web/.next/
packages/web/out/
packages/web/next-env.d.ts
packages/web/.env.local
packages/web/tsconfig.tsbuildinfo

# desktop_v3 (Electron + React + TS UI, handoff §37) — node 빌드 산출물.
# package-lock.json (lockfile) 만 커밋, node_modules / out / dist 는 제외.
desktop_v3/node_modules/
desktop_v3/out/
desktop_v3/dist/
desktop_v3/.vite/
# electron-vite 가 dev/build 시 생성하는 임시 config 파일 (timestamp suffix).
desktop_v3/electron.vite.config.*.mjs
desktop_v3/*.timestamp-*.mjs
# electron-builder 설치본 출력 (handoff §46).
desktop_v3/release/
# PyInstaller freeze 산출물 (사용자가 로컬에서 생성, 커밋 X) — 브리지 동봉용.
desktop_v3/build/pybridge/
# PyInstaller 작업 디렉터리 (프로젝트 루트에서 freeze 시 생성).
build/ohdo-bridge/
dist/ohdo-bridge/
# 단, desktop_v3/build/ 의 freeze 도구 (spec + entry) 는 커밋한다.
# (위 최상단 `build/` 광범위 ignore 의 예외 — desktop_v3/build/ 는 electron-builder
#  buildResources 디렉터리이기도 함.)
!desktop_v3/build/
!desktop_v3/build/bridge_entry.py
!desktop_v3/build/ohdo-bridge.spec
~$*
